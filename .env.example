# Required for real catalog products and Channel3's conversational agent
CHANNEL3_API_KEY=

# Optional: Elastic hybrid lexical + semantic reranking of Channel3 results
ELASTICSEARCH_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX=smartcart-products-v1

# Optional: public product page inspection through Kernel; no purchase actions
KERNEL_API_KEY=

# Set true only for local demos with fictional placeholder products
SMARTCART_DEMO=false
